DJANGO_SECRET_KEY=django-inseguro-apenas-desenvolvimento
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*

# Autenticação de serviço a serviço — clientes que chamam o Gateway
API_KEY=chave-secreta-dev
API_KEY_HEADER=X-API-Key

# Token-MS — roteamento (proxy) ainda em desenvolvimento por outro time
TOKEN_MS_URL=http://token-ms:8000
TOKEN_MS_TIMEOUT=10

# Keycloak Admin API — gestão de credencial (senha/e-mail) e resolução
# de conta (login/dados do usuário)
KEYCLOAK_URL_SERVIDOR=https://localhost:8080/
KEYCLOAK_REALM=COTIC
KEYCLOAK_CLIENT_ID=identidade-gateway
KEYCLOAK_USUARIO_ADMIN=admin
KEYCLOAK_SENHA_ADMIN=admin
KEYCLOAK_VERIFICAR_SSL=true

# Client OIDC usado no login real (grant type password) — precisa ter
# "Direct Access Grants" habilitado no Keycloak e os protocol mappers
# de realm_access/resource_access (roles) configurados. Distinto do
# KEYCLOAK_CLIENT_ID acima (usado só em required actions da Admin API).
# Client confidencial — exige client_secret.
KEYCLOAK_LOGIN_CLIENT_ID=auto-servico-qa
KEYCLOAK_LOGIN_CLIENT_SECRET=