DJANGO_SECRET_KEY=django-inseguro-apenas-desenvolvimento
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*

# Autenticação de serviço a serviço — clientes que chamam o Gateway
API_KEY=chave-secreta-dev
API_KEY_HEADER=X-API-Key

# SME-Identidade-Token-Microsservico — destino do roteamento de
# perfis/níveis de acesso (perfis/{kc_user_id}/) e do health check
# estendido
TOKEN_MS_URL=[url]:[porta]
TOKEN_MS_TIMEOUT=10

# API Key própria para a chamada de serviço Gateway → Token-MS (distinta
# da API_KEY que os clientes usam para chamar o Gateway; deve corresponder
# ao API_KEY configurado no SME-Identidade-Token-Microsservico)
API_KEY_TOKEN_MS=chave-secreta-dev
API_KEY_TOKEN_MS_HEADER=X-API-Key

# SME-Identidade-Audit-Microsservico — destino do gatilho de auditoria
# disparado no login e nas trocas de senha/e-mail. O Gateway não envia
# o evento em si, só avisa que houve atividade; timeout curto porque o
# disparo acontece dentro de fluxos que o usuário está esperando
AUDIT_MS_URL=[url]:[porta]/identidade-auditoria
AUDIT_MS_TIMEOUT=2

# API Key própria para a chamada de serviço Gateway → Audit-MS (distinta
# da API_KEY que os clientes usam para chamar o Gateway; deve corresponder
# ao API_KEY configurado no SME-Identidade-Audit-Microsservico)
API_KEY_AUDIT_MS=chave-secreta-dev
API_KEY_AUDIT_MS_HEADER=X-API-Key

# Keycloak Admin API — gestão de credencial (senha/e-mail) e resolução
# de conta (login/dados do usuário)
KEYCLOAK_URL_SERVIDOR=[url]:[porta]
KEYCLOAK_REALM=COTIC
KEYCLOAK_USUARIO_ADMIN=admin
KEYCLOAK_SENHA_ADMIN=admin
KEYCLOAK_VERIFICAR_SSL=true

# Client OIDC usado no login real (grant type password) e como
# client_id nas required actions de credencial (recuperar/alterar
# senha, alterar e-mail) — precisa ter "Direct Access Grants"
# habilitado, os protocol mappers de realm_access/resource_access
# (roles) configurados, e existir de fato no realm. Client
# confidencial — exige client_secret.
KEYCLOAK_LOGIN_CLIENT_ID=auto-servico-qa
KEYCLOAK_LOGIN_CLIENT_SECRET=

# SME-Identidade-ETL — destino da gestão de usuário (criar, sincronizar,
# conceder acesso, consultar identidade). Inclui o prefixo
# "/identidade-etl" — é parte do roteamento do próprio ETL, não um
# path de proxy externo.
ETL_URL=[url]:[porta]/identidade-etl
ETL_TIMEOUT=30

# API Key própria para a chamada de serviço Gateway → ETL (distinta da
# API_KEY que os clientes usam para chamar o Gateway; deve corresponder
# ao API_KEY configurado no SME-Identidade-ETL)
API_KEY_ETL=chave-secreta-dev
API_KEY_ETL_HEADER=X-API-Key